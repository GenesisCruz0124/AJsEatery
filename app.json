{
  "expo": {
    "name": "Sales Tracker",
    "slug": "ajs-eatery",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ajseatery",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.ajseatery.pos",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#C0392B"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Sales Tracker to access your photos for product images."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
